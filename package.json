{
  "name": "pi-design-mode",
  "version": "0.3.4",
  "description": "Pi 的本地 HTML 设计工作区：组件、tokens、版本历史和交互原型导出。",
  "keywords": [
    "pi-package",
    "pi-extension",
    "design",
    "html",
    "prototype",
    "design-tokens"
  ],
  "author": "liush2yuxjtu",
  "license": "MIT",
  "homepage": "https://liush2yuxjtu.github.io/pi-design-mode/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liush2yuxjtu/pi-design-mode.git"
  },
  "bugs": {
    "url": "https://github.com/liush2yuxjtu/pi-design-mode/issues"
  },
  "type": "module",
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "extensions/html-studio/extension.ts",
    "extensions/html-studio/usage-entry.ts",
    "extensions/html-studio/usage-funnel.ts",
    "extensions/html-studio/server.mjs",
    "extensions/html-studio/store.mjs",
    "extensions/html-studio/public",
    "extensions/html-studio/seed",
    "extensions/html-studio/WORKFLOW.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "README.zh-CN.md",
    "extensions/html-studio/locale.mjs",
    "extensions/html-studio/english.json"
  ],
  "scripts": {
    "start": "node extensions/html-studio/server.mjs",
    "check": "cd extensions/html-studio && node build.mjs",
    "test": "node --experimental-strip-types --test extensions/html-studio/test/*.test.mjs extensions/html-studio/test/*.test.ts",
    "test:extension": "DESIGN_EXTENSION_PATH=extensions/html-studio/usage-entry.ts node tools/check-extension.mjs && PI_DESIGN_LANGUAGE=en DESIGN_EXTENSION_PATH=extensions/html-studio/usage-entry.ts node tools/check-extension.mjs",
    "prepack": "npm run check && npm test && npm run test:extension"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "typescript": "^5.9.2"
  },
  "pi": {
    "extensions": [
      "./extensions/html-studio/usage-entry.ts"
    ],
    "image": "https://liush2yuxjtu.github.io/pi-design-mode/demo-en.gif"
  },
  "dependencies": {
    "@nyn5255/telemetry": "^0.1.3"
  }
}
